# codebadger 체크아웃의 .env로 복사해 값을 채운다. 실제 .env는 커밋하지 않는다.
PLAYGROUND_HOST_PATH=<codebadger 체크아웃 절대 경로>/playground
# MCP는 호스트 루프백에만 연다. 작업자 쪽에서는 SSH 터널로 붙는다.
MCP_PUBLISH_HOST=127.0.0.1
MCP_HOST=0.0.0.0
MCP_PORT=4242
POSTGRES_PASSWORD=<임의 값>
# 그래프 생성 컨테이너
JOERN_MEM_LIMIT=16g
CPG_BUILD_WORKERS=1
CPG_BUILD_HEAP_GB=4
# 질의 워커: NUMA 노드 3, heap 4G
JOERN_WORKER_CPUSET_CPUS=30-39,70-79
JOERN_WORKER_CPUSET_MEMS=3
JOERN_WORKER_HEAP_GB=4
# local 소스를 playground 안으로 제한한다(컨테이너 안 경로)
ALLOWED_SOURCE_ROOTS=/app/playground
