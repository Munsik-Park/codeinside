# codebadger 스택 기동 (docs/plan.md 단계 5).
# Docker data-root도 tmpfs라 재부팅하면 컨테이너와 네트워크가 사라져 restart 정책으로는 다시 뜨지 않는다.
# 이미지 복원 뒤 compose로 다시 만들고, compose에 없는 메모리 노드 고정을 docker update로 건다.
[Unit]
Description=codebadger stack (compose up + NUMA pin)
After=codebadger-image-restore.service
Requires=codebadger-image-restore.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/codebadger/codebadger.conf
ExecStart=/bin/sh -c 'cd "${CODEBADGER_DIR}" && set -a && . ./.env && set +a && docker compose up -d --no-build && docker update --cpuset-cpus "$JOERN_WORKER_CPUSET_CPUS" --cpuset-mems "$JOERN_WORKER_CPUSET_MEMS" codebadger-joern-server'

[Install]
WantedBy=multi-user.target
