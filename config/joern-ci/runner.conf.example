# /etc/codeinside-joern-ci/runner.conf 로 복사한다 (docs/plan.md 단계 6).
# codeinside-joern-ci-net.service와 codeinside-joern-runner.service가 읽는다. 비밀 값은 넣지 않는다.
# PAT는 /etc/codeinside-joern-ci/runner.env(RUNNER_REG_PAT=..., 권한 600)에 따로 둔다.
JOERN_CI_REPO=Munsik-Park/opensre
JOERN_CI_LABELS=joern
# librechat 러너 이미지(부팅 때 librechat-ci-image-restore.service가 복원) 위에 전용 uid 사용자를 더해 쓴다.
# 이미지는 codeinside-joern-ci-net.service가 build-runner-image.sh로 만든다.
JOERN_CI_BASE_IMAGE=librechat-ci-runner:latest
JOERN_CI_RUNNER_IMAGE=codeinside-joern-runner:latest
# 러너 컨테이너의 uid/gid. install.sh가 호스트 시스템 계정 codeinside-runner를 만들고 그 값으로 채운다.
JOERN_CI_RUNNER_UID=
JOERN_CI_RUNNER_GID=
JOERN_CI_RUNNER_NAME=codeinside-joern-runner
JOERN_CI_RUNNER_MEMORY=2g
JOERN_CI_RUNNER_CPUS=4
# NUMA 노드 3 (numactl -H 기준 CPU 30-39, 70-79)
JOERN_CI_CPUSET_CPUS=30-39,70-79
JOERN_CI_CPUSET_MEMS=3
JOERN_CI_NETWORK=codeinside-joern-ci
JOERN_CI_PROXY_NAME=codeinside-mcp-proxy
JOERN_CI_PROXY_IMAGE=codebadger-mcp:latest
JOERN_CI_PROXY_SCRIPT=/opt/codeinside-joern-ci/tcp_proxy.py
JOERN_CI_ENTRYPOINT=/opt/codeinside-joern-ci/entrypoint.sh
CODEBADGER_NETWORK=codebadger
JOERN_CI_MCP_URL=http://codeinside-mcp-proxy:4242/mcp
# 같은 폴더를 호스트와 MCP 컨테이너에서 본 경로. MCP 컨테이너는 /opt/codebadger/playground를 /app/playground로 마운트한다.
JOERN_CI_SRC_HOST_DIR=/opt/codebadger/playground/codebases/ci
JOERN_CI_SRC_MCP_DIR=/app/playground/codebases/ci
