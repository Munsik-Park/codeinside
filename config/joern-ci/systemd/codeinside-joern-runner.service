# opensre 분석 러너 supervisor (docs/plan.md 단계 6). 작업마다 ephemeral 러너 컨테이너를 하나씩 띄운다.
[Unit]
Description=codeinside Joern CI ephemeral runner supervisor (label joern, repo from runner.conf)
After=network-online.target docker.service codeinside-joern-ci-net.service librechat-ci-image-restore.service
Requires=docker.service codeinside-joern-ci-net.service
Wants=network-online.target librechat-ci-image-restore.service

[Service]
Type=simple
User=codeinside-ci
Group=codeinside-ci
EnvironmentFile=/etc/codeinside-joern-ci/runner.env
EnvironmentFile=/etc/codeinside-joern-ci/runner.conf
# codeinside-ci 계정은 홈 폴더가 없다. docker build(buildx)는 ~/.docker를 만들려다 실패하므로
# systemd가 만드는 상태 폴더를 Docker CLI 설정 폴더로 준다.
StateDirectory=codeinside-joern-ci
Environment=DOCKER_CONFIG=/var/lib/codeinside-joern-ci/docker
ExecStart=/opt/codeinside-joern-ci/runner-supervisor.sh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
