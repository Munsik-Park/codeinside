{
  "mcpServers": {
    "ast-grep": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp@51d5a23f025c73c02032a98748dc06942548c5e1",
        "ast-grep-server"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context", "<CODEINSIDE_DIR>/config/serena/context-readonly.yml",
        "--project", "<OPENSRE_DIR>",
        "--agent-interface", "tools",
        "--enable-web-dashboard", "False",
        "--open-web-dashboard", "False"
      ]
    }
  }
}
