## register.sh (TARGET_DIR=$CREWAI_DIR PROJECT_NAME=crewAI PYRIGHTCONFIG=config/serena/crewai/pyrightconfig.json JOERN_MCP_URL=$JOERN_MCP_URL)
ast-grep: uvx --from git+https://github.com/ast-grep/ast-grep-mcp@51d5a23f025c73c02032a98748dc06942548c5e1 ast-grep-server - ✔ Connected
serena: serena start-mcp-server --context $CODEINSIDE_DIR/config/serena/context-readonly.yml --project $CREWAI_DIR --agent-interface tools --enable-web-dashboard False --open-web-dashboard False - ✔ Connected
joern: $JOERN_MCP_URL (HTTP) - ✔ Connected
exit=0
